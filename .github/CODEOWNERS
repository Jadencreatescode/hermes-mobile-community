# Every change requires review by the public repository owner. More-sensitive
# paths below also preserve the upstream hermes-agent-core ownership entries.
* @Jadencreatescode

# Paths that need a hermes-agent-core approval before merge. This replaces the
# ``ci-reviewed`` label gate: GitHub requests the review and enforces it
# (ruleset: "Require review from Code Owners"), so CI no longer needs to
# classify these paths, check a label, or rerun jobs when one is added.
#
# Last match wins. The wildcard keeps public-owner review on every path; the
# more-sensitive rules below additionally request the upstream core owner.
# Patterns without a leading slash match at any depth.

# Workflows, composite actions, and this file: they decide what CI executes
# and what the autofix job pushes to main. The scripts the workflows run get the
# same review for the same reason.
/.github/                       @NousResearch/hermes-agent-core @Jadencreatescode
/scripts/ci/                    @NousResearch/hermes-agent-core @Jadencreatescode
# The code-health gate decides whether a PR passes; weakening it is a CI change.
/scripts/check                  @NousResearch/hermes-agent-core @Jadencreatescode
/scripts/code_health/           @NousResearch/hermes-agent-core @Jadencreatescode

# The committed system prompt + tools[] render every session sends (scripts/ci/prompt_surface.py).
# The prompt-surface-review ruleset requires one hermes-agent-core approval here; this line requests it.
/tests/fixtures/prompt_surface/ @NousResearch/hermes-agent-core @Jadencreatescode

# eslint configs can define custom ``fix`` functions that run arbitrary code.
eslint.config.*                 @NousResearch/hermes-agent-core @Jadencreatescode
/.prettierrc                    @NousResearch/hermes-agent-core @Jadencreatescode

# MCP catalog entries define local commands users later install into
# ``mcp_servers``; the installer decides how they are fetched and run.
/optional-mcps/                 @NousResearch/hermes-agent-core @Jadencreatescode
/hermes_cli/mcp_catalog.py      @NousResearch/hermes-agent-core @Jadencreatescode

# Files that execute at pip-install or interpreter startup.
/setup.py                       @NousResearch/hermes-agent-core @Jadencreatescode
/setup.cfg                      @NousResearch/hermes-agent-core @Jadencreatescode
/sitecustomize.py               @NousResearch/hermes-agent-core @Jadencreatescode
/usercustomize.py               @NousResearch/hermes-agent-core @Jadencreatescode
*.pth                           @NousResearch/hermes-agent-core @Jadencreatescode

# Dependency manifests, resolved pins, and image builds: an edit here changes
# what gets installed and run without touching any reviewed source.
pyproject.toml                  @NousResearch/hermes-agent-core @Jadencreatescode
package.json                    @NousResearch/hermes-agent-core @Jadencreatescode
uv.lock                         @NousResearch/hermes-agent-core @Jadencreatescode
*package-lock.json              @NousResearch/hermes-agent-core @Jadencreatescode
/flake.lock                     @NousResearch/hermes-agent-core @Jadencreatescode
/pm/lock.json                   @NousResearch/hermes-agent-core @Jadencreatescode
*Dockerfile                     @NousResearch/hermes-agent-core @Jadencreatescode

# The npm supply-chain quarantine (min-release-age) lives here.
.npmrc                          @NousResearch/hermes-agent-core @Jadencreatescode

# Where PM fetches artifacts from.
/pm/artifact-mirror.json        @NousResearch/hermes-agent-core @Jadencreatescode

# The installers users pipe into a shell, and the generator for the pins they carry.
/scripts/install.sh             @NousResearch/hermes-agent-core @Jadencreatescode
/scripts/install.ps1            @NousResearch/hermes-agent-core @Jadencreatescode
/scripts/install.cmd            @NousResearch/hermes-agent-core @Jadencreatescode
/scripts/gen-bootstrap-pins.py  @NousResearch/hermes-agent-core @Jadencreatescode

# The trust model and the scope authority for security reports.
/SECURITY.md                    @NousResearch/hermes-agent-core @Jadencreatescode

# Each entry pins a third-party repo by sha; editing it changes what users install.
/plugin-catalog/                @NousResearch/hermes-agent-core @Jadencreatescode
